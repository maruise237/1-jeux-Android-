<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the game's own data (progress, settings, the anonymous install id) is backed up
     and restored, so a player keeps their progress on a new phone. The app stores no credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
    </device-transfer>
</data-extraction-rules>
